SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5433/brokerage
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT signing key. Set a random value of at least 32 characters outside local.
JWT_SECRET=

# JWT cookie lifetime (minutes).
JWT_EXPIRY_MINUTES=1440

# Set true when serving over HTTPS.
COOKIE_SECURE=false

# Comma-separated browser origins allowed to send credentialed API requests.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Virtual funds credited when a user registers.
STARTING_CASH=100000.00

# Optional first-start administrator credentials; both must be set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
